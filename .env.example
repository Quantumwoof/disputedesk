# ---- Everything below is OPTIONAL. With no variables set, DisputeDesk runs in DEMO mode (local PayPal simulator, offline engine).

# PayPal SANDBOX credentials (developer.paypal.com → Apps & Credentials → your Merchant sandbox app).
# Setting these switches the app from DEMO to sandbox mode. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# or a short-lived token: PAYPAL_ACCESS_TOKEN=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# rest = call the Disputes REST API directly; mcp = read/accept through PayPal's own MCP server (@paypal/mcp)
PAYPAL_GATEWAY=rest

# Your shop's order data (JSON export, see data/merchant.example.json). Required in sandbox mode.
# MERCHANT_DATA=./my-shop-export.json

# AI (free paths). none = deterministic offline engine.
#   LLM_PROVIDER=pollinations          -> https://text.pollinations.ai/openai, anonymous, no key
#   LLM_PROVIDER=openai-compatible     -> LLM_BASE_URL / LLM_MODEL / LLM_API_KEY (e.g. local Ollama: http://localhost:11434/v1)
LLM_PROVIDER=none
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# Policy knobs
MIN_FIGHT_AMOUNT=10
SIGNATURE_ABOVE=750
# PORT=4000
